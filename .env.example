# Points at the local Compose service; swap this for a hosted URL in production.
DATABASE_URL="postgresql://orch:orch@localhost:5433/orch"

# 32 random bytes encoded as base64; generate with: openssl rand -base64 32
# Keep this key outside the database, back it up privately, and never commit it.
ACCOUNT_CREDENTIALS_KEY=""

# Model settings below are the defaults until you save connections on the Models page (/settings),
# which also supports any OpenAI-compatible API link and OpenAI keys. Saved API keys need ACCOUNT_CREDENTIALS_KEY.
# AI provider: ollama for the configured main PC, lmstudio, or openrouter.
AI_PROVIDER="ollama"

# LM Studio must be running with a model loaded before requesting a local review.
LMSTUDIO_BASE_URL="http://localhost:1234/v1"
LMSTUDIO_MODEL="qwen3.5-2b"
LMSTUDIO_TIMEOUT_MS="120000"

# Ollama through your ngrok tunnel. Update the URL if the tunnel changes.
OLLAMA_BASE_URL="https://2b0b-138-232-106-215.ngrok-free.app"
OLLAMA_MODEL="gemma4:26b"
OLLAMA_TIMEOUT_MS="240000"
OLLAMA_CONTEXT_LENGTH="32768"

# When AI_PROVIDER=openrouter, create a key yourself and supply it in .env.local.
# Never commit the key. The value intentionally remains empty in this example.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
OPENROUTER_TIMEOUT_MS="120000"
# Optional OpenRouter attribution headers; omitted from requests when empty.
OPENROUTER_SITE_URL=""
OPENROUTER_SITE_NAME=""

CV_UPLOAD_DIR=".uploads"
CV_MAX_BYTES="10485760"
CV_REVIEW_MAX_CHARS="12000"
CV_REWRITE_MAX_CHARS="48000"

# Semantic ranking uses the embedding model loaded on the same Ollama server.
# Set EMBEDDING_PROVIDER=lmstudio to use its OpenAI-compatible endpoint instead.
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="qwen3-embedding:4b"
EMBEDDING_MAX_CHARS="48000"
EMBEDDING_TIMEOUT_MS="60000"
EMBEDDING_BATCH_SIZE="8"
EMBEDDING_CONCURRENCY="1"
JOB_MATCH_TOP_N="20"
JOB_MATCH_CONCURRENCY="1"

# Job source: Indeed (the only one). Indeed discovery uses local Playwright Chromium in a
# visible window, because Indeed blocks headless browsers. Later result pages require the saved Indeed sign-in.
JOB_SOURCES="indeed"
# Indeed sign-in site and fallback for explicit locations with no recognized country.
# Blank location preferences search 12 international country markets, independent of this setting and the CV.
INDEED_BASE_URL="https://de.indeed.com"
# Full postings read per search round (maximum 60).
INDEED_MAX_JOBS=40
# How long discovery keeps an Indeed bot check open for you to complete it in the visible window (0 fails at once).
INDEED_VERIFICATION_WAIT_MS=120000
# Default for the "Posted within" setting on the Pipeline page (1, 3, 7, 14 days, or 0 for any time).
JOB_MAX_AGE_DAYS=14

# Reuse successful screening and verified assessments for 24 hours.
AI_CACHE_ENABLED="true"
# Bump when replacing model weights under the same model name.
AI_CACHE_VERSION="1"

# Automatic retries of a failed pipeline run (waits 1, 5, 15, 30, 60 minutes); 0 turns them off.
PIPELINE_MAX_RETRIES=5
