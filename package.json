{
  "name": "orch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:latex": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/latex/render-cv.test.mjs",
    "test:cv": "node --conditions=react-server --import tsx --test lib/cv/contact-details.test.mjs lib/cv/normalize-extracted-text.test.mjs lib/cv/render-text.test.mjs lib/ai/cv-rewrite-validation.test.mjs lib/ai/cv-rewrite-claims.test.mjs lib/cv/profile-jobs.test.mjs",
    "latex:build": "docker build -t orch-latex:slim docker/latex",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:ai": "node --conditions=react-server --import tsx --test lib/ai/ollama.test.mjs lib/ai/cv-rewrite.test.mjs lib/ai/evidence.test.mjs lib/ai/embeddings.test.mjs lib/ai/job-screening.test.mjs lib/ai/host-url.test.mjs",
    "pipeline:worker": "node --conditions=react-server --import tsx services/pipeline/worker.ts",
    "test:pipeline": "node --conditions=react-server --import tsx --test lib/pipeline/engine.test.mjs lib/pipeline/tailoring.test.mjs",
    "test:pipeline:integration": "node --conditions=react-server --import tsx --test services/pipeline/integration.test.mjs",
    "applications:worker": "node --conditions=react-server --import tsx services/applications/worker.ts",
    "test:applications": "node --conditions=react-server --import tsx --test services/applications/*.test.mjs",
    "test:jobs": "node --conditions=react-server --import tsx --test lib/jobs/retrieval.test.mjs lib/jobs/cached-ai.test.mjs lib/jobs/indeed.test.mjs lib/jobs/similarity.test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.1",
    "next": "16.3.2",
    "patchright": "^1.63.0",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tsx": "^4.23.13",
    "undici": "^6.28.1",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
